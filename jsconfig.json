{
  "compilerOptions": {
    "checkJs": true,
    "allowJs": true,
    "noEmit": true,
    "strict": false,
    "noImplicitAny": false,
    "module": "es2022",
    "target": "es2022",
    "moduleResolution": "bundler",
    "lib": ["es2022", "dom", "dom.iterable", "webworker"],
    "skipLibCheck": true,
    "types": []
  },
  "include": ["js/**/*.js", "sw.js", "pre.js"]
}
